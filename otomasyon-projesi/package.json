{
  "name": "ai-recruitment-system",
  "private": true,
  "version": "1.0.0",
  "description": "AI destekli işe alım ve aday yönetim sistemi",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w @recruitment/backend\" \"npm run dev -w @recruitment/frontend\"",
    "dev:backend": "npm run dev -w @recruitment/backend",
    "dev:frontend": "npm run dev -w @recruitment/frontend",
    "build": "npm run build -w @recruitment/shared && npm run build -w @recruitment/backend && npm run build -w @recruitment/frontend",
    "lint": "npm run lint -w @recruitment/backend && npm run lint -w @recruitment/frontend",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:studio": "prisma studio --schema prisma/schema.prisma"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
